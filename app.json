{
  "expo": {
    "name": "POS Angkringan Jogja",
    "slug": "pos-angkringan-jogja",
    "version": "1.0.1",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "posangkringan",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Gunakan Bluetooth untuk menghubungkan printer thermal kasir dan dapur.",
        "NSCameraUsageDescription": "Izinkan POS Angkringan mengakses kamera untuk absensi karyawan dan foto menu.",
        "NSPhotoLibraryUsageDescription": "Izinkan POS Angkringan mengakses galeri foto untuk memilih logo dan foto menu.",
        "UISupportedExternalAccessoryProtocols": [
          "com.epson.escpos"
        ]
      }
    },
    "android": {
      "package": "com.angkringanjogja.posoffline",
      "versionCode": 2,
      "permissions": [
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#059669",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#f4f8f5"
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Izinkan POS Angkringan mengakses kamera untuk absensi wajah karyawan dan foto menu produk."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Izinkan POS Angkringan mengakses galeri foto untuk memilih logo usaha dan foto menu.",
          "cameraPermission": "Izinkan POS Angkringan mengakses kamera untuk memotret menu dan bukti nota pembelian."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "rikires-team",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a19ef6cd-f6f0-45f5-8529-b4243605c78c"
      }
    }
  }
}
